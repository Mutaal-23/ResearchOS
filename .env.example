# =============================================================================
# ResearchOS - environment template
#
# Copy to .env and fill in real values:   cp .env.example .env
#
# .env is gitignored. NEVER commit real keys.
# =============================================================================

# --- LLM (Google Gemini, used for answer generation + research synthesis) ---
GEMINI_API=your-gemini-api-key
# Comma-separated fallback chain, tried in order on 404/429/503.
# Rationale: model names get deprecated/renamed by the provider without notice.
# A chain means one bad name does not take down the whole app.
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-flash-latest
# Temperature for grounded answers. Keep LOW (0.0-0.2) for factual Q&A:
# higher values invent more, which is exactly what citations are meant to stop.
LLM_TEMPERATURE=0.1
# Hard cap on generation, keeps a runaway response from blowing the context window.
LLM_MAX_TOKENS=2048

# --- PostgreSQL (Docker) ---
# Port 5433 on the host because Postgres 18 is already installed locally on 5432.
POSTGRES_USER=researchos
POSTGRES_PASSWORD=researchos
POSTGRES_DB=researchos
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Qdrant (Docker) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=researchos-dev-key
QDRANT_COLLECTION=researchos_chunks

# --- Embedding + reranking models (local, via fastembed/ONNX) ---
# 384-dim BAAI/bge-small-en-v1.5. Changing the model changes the vector space,
# which means the entire collection must be re-embedded. Treat it like a schema.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Cross-encoder that re-scores candidates. Runs on CPU, ~280MB.
RERANKER_MODEL=BAAI/bge-reranker-base

# --- Ingestion defaults ---
# Chunk size in TOKENS, not characters. Tokens are what the embedding model
# actually truncates on, so character-based counting drifts from reality.
CHUNK_SIZE_TOKENS=400
# Overlap in tokens. Prevents a fact that straddles a boundary from being
# half-in / half-out of a chunk and therefore unretrievable.
CHUNK_OVERLAP_TOKENS=80
# Chunks below this are too small to embed meaningfully - they pollute recall.
MIN_CHUNK_CHARS=80

# --- Retrieval defaults ---
# Candidates pulled from EACH retriever (dense and sparse) before fusion.
# Higher = more recall, more latency, and more work for the reranker.
RETRIEVAL_CANDIDATES=40
# How many chunks survive reranking and reach the LLM. Reranking quality
# matters far more than this number - 5 clean chunks beat 20 noisy ones.
RETRIEVAL_TOP_K=6
# RRF (Reciprocal Rank Fusion) damping constant. 60 is the value from the
# original paper; lower weights top ranks more aggressively.
RRF_K=60

# --- Evaluation ---
# Test set for the eval dashboard.
EVAL_QUESTIONS_PATH=evals/questions.json

# --- Server ---
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
